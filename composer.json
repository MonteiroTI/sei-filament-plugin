{
    "name": "monteiroti/sei-filament-plugin",
    "description": "Plugin do Filament para o conector do SEI: conexões no banco, teste de conexão, catálogos, log das chamadas e consulta de processos.",
    "type": "library",
    "license": "proprietary",
    "repositories": [
        { "type": "vcs", "url": "https://github.com/MonteiroTI/sei-integration-php" }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.3",
        "monteiroti/sei-integration": "dev-main"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "MonteiroTI\\SeiFilament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MonteiroTI\\SeiFilament\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "MonteiroTI\\SeiFilament\\SeiFilamentServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
